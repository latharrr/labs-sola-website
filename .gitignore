# allow-list: publish only what the live page needs
*
!.gitignore
!README.md
!index.html
!vendor/
!vendor/*.js
!vendor/*.css
!img/
!img/*.jpg
!img/*.svg
!frames/
!frames/*.jpg
!frames-m/
!frames-m/*.jpg
!loops/
!loops/hero-web.mp4
!loops/hero-web-sm.mp4
!img/logos/
!img/logos/*.svg
!api/
!api/subscribe.mjs
!vercel.json
!media/
!media/sola-launch-*.mp4
!media/sola-launch-preview.gif
